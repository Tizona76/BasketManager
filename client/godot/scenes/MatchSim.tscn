[sub_resource type="Shader" id="ShaderBroadcastScoreboard"]
resource_local_to_scene = true
code = "shader_type canvas_item;
render_mode unshaded;

float box_distance(vec2 p, vec2 center, vec2 half_size, float radius) {
	vec2 q = abs(p - center) - half_size + vec2(radius);
	return length(max(q, vec2(0.0))) + min(max(q.x, q.y), 0.0) - radius;
}
float box_mask(vec2 p, vec2 center, vec2 half_size, float radius) {
	float d = box_distance(p, center, half_size, radius);
	float aa = max(fwidth(d), 0.65);
	return 1.0 - smoothstep(-aa, aa, d);
}
void fragment() {
	vec2 p = UV * vec2(840.0, 144.0);
	float outer = box_mask(p, vec2(420.0, 72.0), vec2(420.0, 72.0), 14.0);
	float inner = box_mask(p, vec2(420.0, 72.0), vec2(418.8, 70.8), 13.0);
	// A continuous material and inset frame unite all three scoring zones.
	float vertical = clamp(p.y / 144.0, 0.0, 1.0);
	vec3 material = mix(vec3(0.075, 0.155, 0.225), vec3(0.025, 0.060, 0.100), vertical);
	float lower_fade = smoothstep(108.0, 138.0, p.y);
	material = mix(material, vec3(0.012, 0.023, 0.039), lower_fade);
	vec3 rim = mix(vec3(0.24, 0.42, 0.55), vec3(0.035, 0.060, 0.085), vertical);
	vec3 color = mix(rim, material, inner);
	float frame = box_mask(p, vec2(420.0, 65.0), vec2(413.0, 58.0), 10.0);
	float frame_inner = box_mask(p, vec2(420.0, 65.0), vec2(412.0, 57.0), 9.0);
	float frame_edge = max(frame - frame_inner, 0.0) * (1.0 - lower_fade);
	color = mix(color, mix(vec3(0.14, 0.29, 0.39), material, vertical), frame_edge);

	// The score uses the same material, with a restrained continuous darkening.
	float center = smoothstep(222.0, 246.0, p.x) * (1.0 - smoothstep(594.0, 618.0, p.x));
	color *= 1.0 - 0.14 * center * inner * (1.0 - lower_fade);
	float rail_l = box_mask(p, vec2(234.0, 66.0), vec2(0.55, 47.0), 0.4);
	float rail_r = box_mask(p, vec2(606.0, 66.0), vec2(0.55, 47.0), 0.4);
	float rail_fade = smoothstep(15.0, 35.0, p.y) * (1.0 - smoothstep(94.0, 116.0, p.y));
	color = mix(color, vec3(0.12, 0.25, 0.34), max(rail_l, rail_r) * rail_fade);
	float accent = box_mask(p, vec2(420.0, 9.0), vec2(394.0, 0.7), 0.5);
	color = mix(color, vec3(0.18, 0.46, 0.62), accent);

	// The clock capsule shares the material, frame and restrained accent palette.
	float clock = box_mask(p, vec2(462.0, 32.5), vec2(86.0, 26.5), 8.0);
	float clock_inner = box_mask(p, vec2(462.0, 32.5), vec2(84.8, 25.3), 7.0);
	vec3 clock_color = mix(vec3(0.085, 0.175, 0.250), vec3(0.045, 0.100, 0.155), clamp((p.y - 6.0) / 53.0, 0.0, 1.0));
	vec3 clock_rim = mix(vec3(0.24, 0.42, 0.55), vec3(0.12, 0.25, 0.34), clamp((p.y - 6.0) / 53.0, 0.0, 1.0));
	color = mix(color, clock_rim, clock);
	color = mix(color, clock_color, clock_inner);
	COLOR = vec4(color, outer * 0.99) * COLOR;
}
"

